{
  "name": "vectorcalc-desktop",
  "productName": "VECTORCALC",
  "version": "1.0.0",
  "description": "VECTORCALC - offline engineering and scientific calculator",
  "main": "main.js",
  "author": {
    "name": "saxxshamdev"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-web.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win --x64",
    "dist:portable": "npm run sync && electron-builder --win portable --x64",
    "dist:linux": "npm run sync && electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vectorcalc.app",
    "productName": "VECTORCALC",
    "copyright": "Copyright (c) 2026 saxxshamdev",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.js",
      "package.json",
      "web/**/*"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VECTORCALC"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build-resources/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "build-resources/icon.png"
    }
  }
}
